        "science"
      ],
      "needs_review": false,
      "formula_latex": "{}^nP_r=\\frac{n!}{(n-r)!}",
      "formula_plain": "nPr = n!/(n−r)!",
      "explanation": "Counts ordered selections of r objects from n distinct objects.",
      "variables": [
        {
          "symbol": "n",
          "meaning": "number of objects",
          "unit": ""
        },
        {
          "symbol": "r",
          "meaning": "objects selected",
          "unit": ""
        }
      ],
      "when_to_use": "Use when order matters.",
      "conditions": [
        "0 ≤ r ≤ n."
      ],
      "example": {
        "question": "Find 5P2.",
        "solution": "5!/(3!) = 5×4.",
        "answer": "20"
      },
      "common_mistakes": [
        "Using combinations when order matters."
      ],
      "related_formula_ids": []
    },
