      "needs_review": false,
      "formula_latex": "{}^nC_r=\\frac{n!}{r!(n-r)!}",
      "formula_plain": "nCr = n!/[r!(n−r)!]",
      "explanation": "Counts unordered selections.",
      "variables": [
        {
          "symbol": "n",
          "meaning": "number of objects",
          "unit": ""
        },
        {
          "symbol": "r",
          "meaning": "objects selected",
          "unit": ""
        }
      ],
      "when_to_use": "Use when order does not matter.",
      "conditions": [
        "0 ≤ r ≤ n."
      ],
      "example": {
