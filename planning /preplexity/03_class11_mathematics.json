    {
      "id": "math_permutation",
      "type": "formula",
      "title": "Permutations",
      "subject_id": "cbse_class11_mathematics",
      "unit_id": "",
      "chapter_id": "cbse_class11_mathematics_6",
      "topic_id": "cbse_class11_mathematics_6_core",
      "summary": "Counts ordered selections of r objects from n distinct objects.",
      "keywords": [
        "permutations",
        "class 11",
        "quick revision"
      ],
      "tags": [
        "quick_revision"
      ],
      "difficulty": "medium",
      "importance": 5,
      "classes": [
