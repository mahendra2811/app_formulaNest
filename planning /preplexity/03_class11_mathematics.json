      "explanation": "General term in the expansion of (a+b)^n.",
      "variables": [
        {
          "symbol": "n",
          "meaning": "non-negative integer index",
          "unit": ""
        },
        {
          "symbol": "r",
          "meaning": "term index starting at 0",
          "unit": ""
        }
      ],
      "when_to_use": "Use to find a particular term.",
      "conditions": [
        "The term number is r+1, not r."
      ],
      "example": {
        "question": "Find the second term of (x+2)^3.",
        "solution": "r=1: 3C1 x²×2.",
        "answer": "6x²"
      },
