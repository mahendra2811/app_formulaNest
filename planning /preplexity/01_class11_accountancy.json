      ],
      "needs_review": false,
      "formula_latex": "GP=Net Sales-COGS",
      "formula_plain": "Gross profit = Net sales − Cost of goods sold",
      "explanation": "Gross profit is the surplus from trading before operating expenses.",
      "variables": [
        {
          "symbol": "GP",
          "meaning": "gross profit",
          "unit": "currency"
        },
        {
          "symbol": "COGS",
          "meaning": "cost of goods sold",
          "unit": "currency"
        }
      ],
      "when_to_use": "Use in the trading account.",
      "conditions": [
        "Net sales means sales less returns inward."
      ],
      "example": {
        "question": "Net sales 80,000 and COGS 50,000.",
        "solution": "GP=80,000−50,000.",
        "answer": "30,000"
      },
      "common_mistakes": [
        "Using purchases instead of COGS."
      ],
