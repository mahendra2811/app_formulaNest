    {
      "id": "accounting_equation",
      "type": "formula",
      "title": "Accounting Equation",
      "subject_id": "cbse_class11_accountancy",
      "unit_id": "",
      "chapter_id": "cbse_class11_accountancy_2",
      "topic_id": "cbse_class11_accountancy_2_core",
      "summary": "Every transaction preserves the equality between assets and claims.",
      "keywords": [
        "accounting equation",
        "quick revision",
        "cbse commerce"
      ],
      "tags": [
        "formula",
        "quick_revision"
      ],
      "difficulty": "medium",
      "importance": 5,
      "classes": [
        11
      ],
      "boards": [
        "CBSE"
      ],
      "exams": [],
      "streams": [
        "commerce"
      ],
      "needs_review": false,
      "formula_latex": "A=L+C",
      "formula_plain": "Assets = Liabilities + Capital",
      "explanation": "Every transaction preserves the equality between assets and claims.",
      "variables": [
        {
          "symbol": "A",
          "meaning": "assets",
          "unit": "currency"
        },
        {
          "symbol": "L",
          "meaning": "liabilities",
          "unit": "currency"
        },
        {
          "symbol": "C",
          "meaning": "capital",
          "unit": "currency"
        }
      ],
      "when_to_use": "Use to analyse the effect of transactions.",
      "conditions": [
        "Every transaction has equal debit and credit effects."
      ],
      "example": {
        "question": "If liabilities are 20,000 and capital is 30,000, find assets.",
        "solution": "A=20,000+30,000.",
        "answer": "50,000"
      },
      "common_mistakes": [
        "Treating revenue as a direct asset without considering capital effect."
      ],
      "related_formula_ids": []
    },
    {
      "id": "accounting_gross_profit",
      "type": "formula",
      "title": "Gross Profit",
      "subject_id": "cbse_class11_accountancy",
      "unit_id": "",
      "chapter_id": "cbse_class11_accountancy_3",
      "topic_id": "cbse_class11_accountancy_3_core",
      "summary": "Gross profit is the surplus from trading before operating expenses.",
      "keywords": [
        "gross profit",
        "quick revision",
        "cbse commerce"
      ],
      "tags": [
        "formula",
        "quick_revision"
      ],
      "difficulty": "medium",
      "importance": 5,
      "classes": [
