      "needs_review": false,
      "formula_latex": "D=\\frac{Cost-Residual\\ Value}{Useful\\ Life}",
      "formula_plain": "D = (Cost − Residual value) / Useful life",
      "explanation": "Equal depreciation is charged each period under SLM.",
      "variables": [
        {
          "symbol": "D",
          "meaning": "annual depreciation",
          "unit": "currency/year"
        },
        {
          "symbol": "Cost",
          "meaning": "asset cost",
          "unit": "currency"
        }
      ],
      "when_to_use": "Use when equal periodic depreciation is appropriate.",
      "conditions": [
        "Useful life and residual value must be specified."
      ],
      "example": {
        "question": "Cost 100,000, residual 10,000, life 9 years.",
        "solution": "D=(100,000−10,000)/9.",
        "answer": "10,000 per year"
      },
      "common_mistakes": [
        "Ignoring residual value."
      ],
