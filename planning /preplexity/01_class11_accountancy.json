    {
      "id": "accounting_slm_depreciation",
      "type": "formula",
      "title": "Straight-Line Depreciation",
      "subject_id": "cbse_class11_accountancy",
      "unit_id": "",
      "chapter_id": "cbse_class11_accountancy_2",
      "topic_id": "cbse_class11_accountancy_2_core",
      "summary": "Equal depreciation is charged each period under SLM.",
      "keywords": [
        "straight-line depreciation",
        "quick revision",
        "cbse commerce"
      ],
      "tags": [
        "formula",
