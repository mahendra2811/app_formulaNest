      "needs_review": false,
      "formula_latex": "\\bar{x}=\\frac{\\sum x}{N}",
      "formula_plain": "x̄ = Σx/N",
      "explanation": "Mean of ungrouped observations.",
      "variables": [
        {
          "symbol": "x̄",
          "meaning": "arithmetic mean",
          "unit": "same as data"
        },
        {
          "symbol": "N",
          "meaning": "number of observations",
          "unit": "count"
        }
      ],
      "when_to_use": "Use for ungrouped data.",
      "conditions": [
        "All observations receive equal weight."
      ],
      "example": {
        "question": "Find mean of 2,4,6.",
        "solution": "(2+4+6)/3.",
        "answer": "4"
      },
      "common_mistakes": [
        "Dividing by wrong number of observations."
      ],
