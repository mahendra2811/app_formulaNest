      "id": "math_quadratic_roots",
      "type": "formula",
      "title": "Quadratic Formula",
      "subject_id": "cbse_class10_mathematics",
      "unit_id": "",
      "chapter_id": "cbse_class10_mathematics_4",
      "topic_id": "cbse_class10_mathematics_4_core",
      "formula_latex": "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}",
      "formula_plain": "x = (-b ± √(b² − 4ac)) / 2a",
      "summary": "Gives the roots of ax² + bx + c = 0.",
      "explanation": "Gives the roots of ax² + bx + c = 0.",
      "variables": [
        {
          "symbol": "a",
          "meaning": "coefficient of x²",
          "unit": ""
        },
        {
          "symbol": "b",
          "meaning": "coefficient of x",
          "unit": ""
        },
        {
          "symbol": "c",
          "meaning": "constant term",
          "unit": ""
        },
        {
          "symbol": "x",
          "meaning": "root",
          "unit": ""
        }
      ],
      "when_to_use": "Use to solve a quadratic equation.",
      "conditions": [
        "a ≠ 0",
        "Equation must be in standard form."
      ],
      "example": {
        "question": "Solve x² − 5x + 6 = 0.",
        "solution": "x = (5 ± √(25 − 24))/2 = (5 ± 1)/2.",
        "answer": "x = 2 or 3"
      },
      "common_mistakes": [
        "Sign errors in b.",
        "Forgetting ±."
      ],
