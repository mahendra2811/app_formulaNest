    {
      "id": "math_bayes_theorem",
      "type": "formula",
      "title": "Bayes’ Theorem",
      "subject_id": "cbse_class12_mathematics",
      "unit_id": "",
      "chapter_id": "cbse_class12_mathematics_13",
      "topic_id": "cbse_class12_mathematics_13_core",
      "summary": "Updates probabilities using evidence B.",
      "keywords": [
        "bayes’ theorem",
        "class 12",
        "quick revision"
      ],
      "tags": [
        "quick_revision"
      ],
      "difficulty": "medium",
      "importance": 5,
      "classes": [
        12
      ],
      "boards": [
