    {
      "id": "math_derivative_product_rule",
      "type": "formula",
      "title": "Product Rule",
      "subject_id": "cbse_class12_mathematics",
      "unit_id": "",
      "chapter_id": "cbse_class12_mathematics_5",
      "topic_id": "cbse_class12_mathematics_5_core",
      "summary": "Derivative rule for a product of differentiable functions.",
      "keywords": [
        "product rule",
        "class 12",
        "quick revision"
      ],
      "tags": [
        "quick_revision"
      ],
      "difficulty": "medium",
      "importance": 5,
      "classes": [
        12
      ],
      "boards": [
        "CBSE"
      ],
      "exams": [],
      "streams": [
        "science"
      ],
      "needs_review": false,
      "formula_latex": "\\frac{d}{dx}(uv)=u\\frac{dv}{dx}+v\\frac{du}{dx}",
      "formula_plain": "d(uv)/dx = u dv/dx + v du/dx",
      "explanation": "Derivative rule for a product of differentiable functions.",
      "variables": [
        {
          "symbol": "u,v",
          "meaning": "functions of x",
          "unit": ""
        }
      ],
      "when_to_use": "Use when two functions are multiplied.",
      "conditions": [
        "Both functions must be differentiable."
      ],
      "example": {
        "question": "Differentiate x² sin x.",
        "solution": "2x sin x + x² cos x.",
        "answer": "2x sin x + x² cos x"
      },
      "common_mistakes": [
        "Differentiating only one factor."
      ],
      "related_formula_ids": []
    },
    {
      "id": "math_integration_by_parts",
      "type": "formula",
      "title": "Integration by Parts",
