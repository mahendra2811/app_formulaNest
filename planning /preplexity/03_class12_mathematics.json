      "needs_review": false,
      "formula_latex": "\\int u\\,dv=uv-\\int v\\,du",
      "formula_plain": "∫u dv = uv − ∫v du",
      "explanation": "Integrates a product by selecting u and dv strategically.",
      "variables": [
        {
          "symbol": "u",
          "meaning": "chosen function",
          "unit": ""
        },
        {
          "symbol": "dv",
          "meaning": "remaining differential",
          "unit": ""
        }
      ],
      "when_to_use": "Use for products such as x sin x or x log x.",
      "conditions": [
        "Choice of u affects simplicity."
      ],
      "example": {
        "question": "Evaluate ∫x dx.",
        "solution": "Take u=x,dv=dx; result x²/2.",
