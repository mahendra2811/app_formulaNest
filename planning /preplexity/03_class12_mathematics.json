      ],
      "needs_review": false,
      "formula_latex": "P(A_i|B)=\\frac{P(A_i)P(B|A_i)}{\\sum_jP(A_j)P(B|A_j)}",
      "formula_plain": "P(Aᵢ|B) = P(Aᵢ)P(B|Aᵢ) / ΣP(Aⱼ)P(B|Aⱼ)",
      "explanation": "Updates probabilities using evidence B.",
      "variables": [
        {
          "symbol": "P(A|B)",
          "meaning": "conditional probability",
          "unit": ""
        }
      ],
      "when_to_use": "Use when prior causes and observed evidence are given.",
      "conditions": [
        "Causes must form a mutually exclusive and exhaustive partition."
      ],
      "example": {
        "question": "What does Bayes theorem calculate?",
        "solution": "It reverses conditional probability using priors.",
        "answer": "Posterior probability"
      },
      "common_mistakes": [
        "Swapping P(A|B) and P(B|A)."
      ],
