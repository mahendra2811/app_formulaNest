      "formula_latex": "Current\\ Ratio=\\frac{Current\\ Assets}{Current\\ Liabilities}",
      "formula_plain": "Current ratio = Current assets / Current liabilities",
      "explanation": "Measures short-term liquidity.",
      "variables": [
        {
          "symbol": "CA",
          "meaning": "current assets",
          "unit": "currency"
        },
        {
          "symbol": "CL",
          "meaning": "current liabilities",
          "unit": "currency"
        }
      ],
      "when_to_use": "Use for liquidity analysis.",
      "conditions": [
        "Use comparable balance-sheet figures."
      ],
      "example": {
        "question": "CA 200,000 and CL 100,000.",
        "solution": "200,000/100,000.",
        "answer": "2:1"
      },
      "common_mistakes": [
        "Including non-current assets."
